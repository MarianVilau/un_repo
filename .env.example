# Copy to .env (make up does it for you). Ports only, no secrets: the admin password
# lives in secrets/opensearch.enc.yaml and reaches compose through .env.secrets (R-02).
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
HTTPS_PORT=443

# Used by pipelines/eve. The Logstash service itself arrives in Session 6.
LOGSTASH_BEATS_PORT=5044
OPENSEARCH_HOST=opensearch
OPENSEARCH_USER=admin
EVE_MAX_LINE_BYTES=16384

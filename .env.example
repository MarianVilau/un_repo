# Copy to .env (make up does it for you). Ports only, no secrets: the admin password
# lives in secrets/opensearch.enc.yaml and reaches compose through .env.secrets (R-02).
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
HTTPS_PORT=443

# Used by pipelines/eve. The Logstash service itself arrives in Session 6.
LOGSTASH_BEATS_PORT=5044
OPENSEARCH_HOST=opensearch
OPENSEARCH_USER=admin
EVE_MAX_LINE_BYTES=16384

# Threat intelligence (Session 6). No keys here: they live in secrets/misp.enc.yaml and
# secrets/shodan.enc.yaml (scripts/add-secret.sh). Values below are placeholders.
MISP_URL=https://misp.lab
MISP_VERIFY_TLS=true
MISP_LAST=30d
MISP_DICTIONARY_PATH=pipelines/eve/dictionaries/misp_ip.yml
SHODAN_API_HOST=api.shodan.io
SHODAN_TARGET_IP=198.51.100.10
SHODAN_EXPECTED_PORTS=443
